---
import '../../styles/global.css';
const {user,localPreview}=Astro.locals;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><meta name="theme-color" content="#f8f7f3" /><title>The Writing Desk — Vanity Vair</title><link rel="icon" href="/favicon.svg" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;1,6..96,400&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" /></head><body>
<a class="skip-link" href="#desk-main">Skip to writing desk</a>
<header class="desk-header"><a class="desk-brand" href="/" aria-label="Vanity Vair home"><strong>VANITY VAIR</strong><span>THE WRITING DESK</span></a><a href="/" target="_blank" rel="noopener">View the magazine ↗</a></header>
{localPreview&&<div class="local-banner"><span><strong>LOCAL PREVIEW</strong> · Sample accounts. Changes stay on this laptop.</span><label>Try as <select id="preview-role" aria-label="Preview account"><option value="owner" selected={user?.role==='owner'}>Owner / editor</option><option value="contributor" selected={user?.role==='contributor'}>Maya / contributor</option></select></label></div>}
<div class="desk-shell"><nav class="desk-sidebar" aria-label="Writing desk"><p class="eyebrow">YOUR LITTLE CORNER</p><button class="desk-tab active" data-tab="stories">{user?.role==='owner'?'All stories':'My stories'} <span>↗</span></button>{user?.role==='owner'&&<><button class="desk-tab" data-tab="review">For review <span id="review-count" class="count">0</span></button><button class="desk-tab" data-tab="ads">Ads</button><button class="desk-tab" data-tab="people">Our people</button></>}<button class="desk-tab" data-tab="gallery">Gallery</button><button class="desk-tab" data-tab="trash">Trash</button><button class="desk-tab" data-tab="profile">My profile</button><button class="desk-tab" data-tab="media">Photo library</button><div class="desk-user">{user?.name}<small>{user?.role==='owner'?'Owner & editor':'Contributor'}{!localPreview&&<> · <button id="sign-out" type="button">Sign out</button></>}</small></div></nav><main class="desk-content" id="desk-main"><div class="initial-loading" role="status">Opening your writing desk…</div></main></div>
<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
<script>import '../../scripts/editor';</script>
</body></html>
