---
import Magazine from '../layouts/Magazine.astro';
import StoryListing from '../components/StoryListing.astro';
import {publishedStories} from '../lib/store';
const q=(Astro.url.searchParams.get('q')||'').trim().slice(0,150);
const all=await publishedStories();
const stories=all.filter(s=>`${s.title} ${s.deck} ${s.author_name} ${s.body.replace(/<[^>]*>/g,' ')}`.toLowerCase().includes(q.toLowerCase()));
---
<Magazine title="All Stories" active="all" demo={all.some(s=>s.id.startsWith('demo-'))}>
  <StoryListing grid title="All Stories" stories={stories} emptyMessage="No stories found. Try another name or a different word.">
    <form id="search" class="archive-search" action="/archive"><label for="story-search" class="eyebrow">FIND A STORY</label><div><input id="story-search" type="search" name="q" value={q} placeholder="A name, an idea, a bit of good news…" maxlength="150" /><button class="button" type="submit">Search <span class="button-arrow" aria-hidden="true"></span></button></div></form>
    {q&&<p class="results-count">{stories.length} {stories.length===1?'story':'stories'} for “{q}” · <a href="/archive">Clear search</a></p>}
  </StoryListing>
</Magazine>
<style>.archive-search{border-top:0;padding-top:0;margin-bottom:20px}</style>
