---
import '../styles/global.css';
const joining=Astro.url.searchParams.get('mode')==='join';
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('Referrer-Policy','no-referrer');
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Sign in — Vanity Vair</title></head><body><main class="wrap" style="max-width:520px;padding-block:70px"><a href="/" class="eyebrow">VANITY VAIR</a><h1 style="font-size:64px;margin:24px 0">{joining?'Make yourself at home.':'Your little corner.'}</h1><p>{joining?'Choose a password to activate your invitation.':'Sign in to the writing desk.'}</p><form id="login-form" data-action={joining?'join':'login'}>{!joining&&<label style="display:block;margin:24px 0">Email<input class="form-input" name="email" type="email" required autocomplete="username" style="display:block;width:100%;padding:14px;margin-top:8px"/></label>}<label style="display:block;margin:24px 0">{joining?'Choose a password':'Password'}<input class="form-input" name="password" type="password" required minlength="14" maxlength="128" autocomplete={joining?'new-password':'current-password'} style="display:block;width:100%;padding:14px;margin-top:8px"/></label>{joining&&<p>Use at least 14 characters. A few unrelated words make a good passphrase.</p>}<p id="login-error" role="alert" style="color:var(--red)"></p><button class="button" type="submit">{joining?'Set password & sign in':'Sign in'}</button></form><p style="margin-top:28px;color:var(--muted)">Invitation only. Need access or a password reset? Ask the editor for a new invitation link.</p></main><script>
const form=document.querySelector<HTMLFormElement>('#login-form')!;
const token=location.hash.slice(1);if(token)history.replaceState(null,'',location.pathname+location.search);
form.addEventListener('submit',async event=>{event.preventDefault();const button=form.querySelector('button')!;button.disabled=true;const error=document.querySelector('#login-error')!;error.textContent='';try{const data=Object.fromEntries(new FormData(form));const response=await fetch(`/auth/${form.dataset.action}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...data,token})});const result=await response.json();if(!response.ok)throw new Error(result.error||'Please try again.');location.assign('/editor');}catch(e){error.textContent=e instanceof Error?e.message:'Connection interrupted. Please try again.';button.disabled=false;}});
</script></body></html>
