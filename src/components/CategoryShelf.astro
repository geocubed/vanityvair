---
import type { Category, Story } from '../lib/types';
interface Props { category: Category; stories: Story[] }
const { category, stories } = Astro.props;
const slug = category.toLowerCase();
const items = stories.slice(0, 4);
---
{items.length > 0 && <section class="category-shelf" aria-labelledby={`shelf-${slug}`}>
  <header class="shelf-heading">
    <h2 id={`shelf-${slug}`}><a href={`/category/${slug}`}>{category}</a></h2>
    <a class="shelf-all" href={`/category/${slug}`} aria-label={`View all ${category.toLowerCase()}`}>View all <span aria-hidden="true">↗</span></a>
  </header>
  <div class="shelf-stories" style={`--shelf-columns:${Math.min(items.length, 4)}`}>
    {items.map(story => <article class="shelf-story">
      <a class="shelf-image" href={`/stories/${story.slug}`} tabindex="-1" aria-hidden="true"><img src={story.hero || '/placeholder.svg'} alt="" width="600" height="600" loading="lazy" /></a>
      <div class="shelf-copy">
        <p class="shelf-kicker">{story.author_slug ? <a href={`/people/${story.author_slug}`}>{story.author_name}</a> : 'From our people'}</p>
        <h3><a href={`/stories/${story.slug}`}>{story.title}</a></h3>
      </div>
    </article>)}
  </div>
</section>}
<style>
  .category-shelf{padding-top:11px;border-top:3px solid var(--ink);margin-bottom:56px}
  .category-shelf:last-child{margin-bottom:0}
  .shelf-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:28px}
  .shelf-heading h2{font-family:var(--sans);font-size:22px;line-height:1.3;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin:0}
  .shelf-all{font-size:9px;white-space:nowrap;letter-spacing:.5px}
  .shelf-all span{font-size:17px;margin-left:7px}
  .shelf-stories{display:grid;grid-template-columns:repeat(var(--shelf-columns),minmax(0,1fr));gap:0}
  .shelf-story{min-width:0;padding:0 17px;border-right:1px solid var(--line)}
  .shelf-story:first-child{padding-left:0}
  .shelf-story:last-child{padding-right:0;border-right:0}
  .shelf-image{display:block;overflow:hidden;background:#dedbd3}
  .shelf-image img{aspect-ratio:1;max-height:370px;height:auto;transition:transform .4s}
  .shelf-image:hover img{transform:scale(1.025)}
  .shelf-copy{padding-top:17px}
  .shelf-kicker{font-family:var(--sans);color:var(--red);font-size:9px;font-weight:600;letter-spacing:1.5px;line-height:1.5;text-transform:uppercase;margin:0 0 10px}
  .shelf-story h3{font-family:var(--serif);font-size:28px;font-weight:400;line-height:1.12;letter-spacing:-.45px;margin:0;max-width:500px}
  .shelf-story h3 a:hover{text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1px}
  .shelf-heading h2 a:hover,.shelf-all:hover{color:var(--red)}
  @media(max-width:1000px){.shelf-story{padding-inline:13px}.shelf-story h3{font-size:25px}.shelf-heading h2{font-size:20px}.shelf-stories{grid-template-columns:repeat(min(var(--shelf-columns),2),minmax(0,1fr));row-gap:28px}.shelf-story:nth-child(2n){padding-right:0;border-right:0}.shelf-story:nth-child(2n+1){padding-left:0}}
  @media(max-width:480px){.category-shelf{margin-bottom:36px;border-top-width:2px;padding-top:12px}.shelf-heading{margin-bottom:21px;gap:10px}.shelf-heading h2{font-size:17px;letter-spacing:1.4px}.shelf-all{font-size:8px}.shelf-stories{grid-template-columns:1fr;gap:28px}.shelf-story{padding:0;border:0}.shelf-image img{aspect-ratio:1.15;max-height:none}.shelf-story h3{font-size:29px;line-height:1.08}.shelf-kicker{font-size:8px;margin-bottom:8px}.shelf-copy{padding-top:14px}}
</style>
