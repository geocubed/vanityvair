---
import type {Story} from '../lib/types';
import {hydrateStoryPhotos} from '../lib/store';
import {articleBody,dateLabel,captionMarkup} from '../lib/content';
import {formatPhotoCredit} from '../lib/photo-metadata';
import FriendImage from './FriendImage.astro';
const {story:sourceStory,preview=false}=Astro.props as {story:Story;preview?:boolean};
const story=await hydrateStoryPhotos(sourceStory);
const hasPoster=!preview && Astro.locals.friendImages.some(item => item.format === 'poster');
---
<article class="article-page wrap">
  {preview&&<div class="article-preview-note">PRIVATE PREVIEW · Only the editorial team can see this version. <a href={`/editor?story=${story.id}`}>Back to the Kitchen ↗</a></div>}
  <header class="article-heading"><span class="eyebrow category">{story.category||'FROM OUR PEOPLE'}</span><h1>{story.title}</h1><p class="article-deck">{story.deck}</p><div class="article-meta">{<a class="byline-portrait" href={`/people/${story.author_slug}`} aria-label={`About ${story.author_name}`}><img class="contributor-portrait" src={story.author_avatar || "/profile-placeholder.svg"} alt="" width="80" height="80" /></a>}<span class="article-byline">By <a href={`/people/${story.author_slug}`}>{story.author_name}</a></span><time datetime={story.published_at||story.created_at}>{dateLabel(story.published_at||story.created_at)}</time></div></header>
  {story.hero&&<figure class="article-hero"><img src={story.hero} alt={story.hero_alt} width="1600" height="1100" fetchpriority="high" />{(story.caption || story.photo_credit)&&<figcaption>{story.caption && <span set:html={captionMarkup(story.caption)} />}{story.photo_credit && <span class="photo-credit">{formatPhotoCredit(story.photo_credit)}</span>}</figcaption>}</figure>}
  <div class:list={['article-content',{'with-friend':hasPoster}]}><aside class="article-rail"><span class="eyebrow">PASS IT ON</span><button class="share-button" type="button">Share story ↗</button><a href="/archive">More stories ↗</a></aside><div class="prose" set:html={articleBody(story.body)}></div>{hasPoster && <div class="article-friend-rail"><FriendImage format="poster" placement="side" /></div>}</div>
  <div class="article-end"><p>Good stories deserve good company.</p><a class="text-link" href="/archive">Keep reading ↗</a></div>
</article>
<style>
  .article-hero figcaption{display:flex;justify-content:space-between;gap:8px 24px;flex-wrap:wrap}.photo-credit{margin-left:auto}
  @media(min-width:1001px){.article-content.with-friend{grid-template-columns:90px minmax(0,680px) minmax(150px,200px);gap:32px;padding-right:0}.article-friend-rail{padding-top:8px;position:sticky;top:24px;align-self:start}}
  @media(max-width:1000px){.article-friend-rail{display:none}}
</style>
<script>
  document.querySelector('.share-button')?.addEventListener('click',async()=>{
    try { if(navigator.share) await navigator.share({title:document.title,url:location.href}); else if(navigator.clipboard) { await navigator.clipboard.writeText(location.href); document.querySelector('.share-button')!.textContent='Link copied ✓'; } else { window.prompt('Copy this story link',location.href); } } catch { /* User dismissed the share sheet. */ }
  });
</script>
