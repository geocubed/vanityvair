---
const { demo = false } = Astro.props;
---
<footer class="magazine-footer">
  <div class="wrap">
    <div class="footer-directory">
      <div class="footer-identity">
        <a class="footer-masthead" href="/" aria-label="Vanity Vair home">VANITY VAIR</a>
        <p>Your friends. Front-page material.</p>
      </div>
      <nav class="footer-column" aria-labelledby="footer-explore">
        <h2 id="footer-explore">MORE FROM VANITY VAIR</h2>
        <a href="/about">About Vanity Vair</a>
        <a href="/archive">All stories</a>
        <a href="/category/achievements">Achievements</a>
        <a href="/category/announcements">Announcements</a>
        <a href="/category/projects">Projects</a>
      </nav>
      <nav class="footer-column" aria-labelledby="footer-involved">
        <h2 id="footer-involved">GET INVOLVED</h2>
        <a href="/editor">Write a story</a>
        <a href="/editor">Contributor sign in</a>
        <a href="/about#promotions">Promote your business</a>
        <a href="/about">Meet the magazine</a>
      </nav>
    </div>
    <div class="footer-utility">
      <nav aria-label="Footer resources">
        <a href="/about">About the publication</a>
        <a href="/about#promotions">Our promotions</a>
        <a href="/archive#search">Search the archive</a>
        <a href="/editor">The writing desk</a>
      </nav>
      <span class="footer-edition">FRIENDS &amp; FAMILY EDITION</span>
    </div>
    <div class="footer-legal">
      <p>© {new Date().getFullYear()} Vanity Vair. An independent parody publication. Not affiliated with, endorsed by, or connected to Vanity Fair or Condé Nast.</p>
      {demo && <p class="footer-preview">PREVIEW EDITION · SAMPLE CONTENT</p>}
    </div>
  </div>
</footer>
<style>
  .magazine-footer{background:#080808;color:#fff;padding:56px 0 42px;margin-top:0}
  .footer-directory{display:grid;grid-template-columns:2fr 1fr 1fr;gap:60px;padding-bottom:43px;border-bottom:1px solid #a6a6a6}
  .footer-identity{align-self:center}
  .footer-masthead{font-family:var(--sans);font-weight:700;font-size:38px;line-height:1;letter-spacing:-2px;display:inline-block}
  .footer-identity p{color:#aaa;font-size:12px;margin:15px 0 0}
  .footer-column{display:flex;flex-direction:column;align-items:flex-start;gap:8px}
  .footer-column h2{font-family:var(--sans);font-size:10px;letter-spacing:2px;line-height:1.5;font-weight:700;margin:0 0 13px}
  .footer-column a{font-size:12px;line-height:1.5}
  .magazine-footer a:hover{text-decoration:underline;text-underline-offset:4px}
  .magazine-footer a:focus-visible{outline-color:#fff}
  .footer-utility{display:flex;align-items:center;justify-content:space-between;gap:30px;padding:32px 0 25px}
  .footer-utility nav{display:flex;flex-wrap:wrap;row-gap:10px;color:#999}
  .footer-utility nav a{font-size:10px;line-height:1.4;padding:0 11px;border-right:1px solid #555}
  .footer-utility nav a:first-child{padding-left:0}
  .footer-utility nav a:last-child{border-right:0}
  .footer-edition{flex-shrink:0;border:1px solid #777;padding:15px 18px;font-size:8px;font-weight:500;letter-spacing:1.5px}
  .footer-legal{font-size:10px;line-height:1.8;color:#888}
  .footer-legal p{margin:0;max-width:1100px}
  .footer-legal .footer-preview{margin-top:12px;color:#777;font-size:8px;letter-spacing:1.5px}
  @media(max-width:1000px){.footer-directory{grid-template-columns:1.4fr 1fr 1fr;gap:30px}.footer-masthead{font-size:32px}.footer-utility{align-items:flex-start}.footer-edition{padding:13px 12px;font-size:7px}}
  @media(max-width:600px){.magazine-footer{padding:36px 0 30px}.footer-directory{grid-template-columns:1fr 1fr;gap:32px 22px;padding-bottom:30px}.footer-identity{grid-column:1/-1}.footer-masthead{font-size:32px}.footer-identity p{font-size:11px;margin-top:10px}.footer-column h2{font-size:8px;letter-spacing:1.3px;min-height:24px;margin-bottom:8px}.footer-column a{font-size:12px}.footer-utility{flex-direction:column;gap:23px;padding-block:25px}.footer-utility nav{gap:12px 18px}.footer-utility nav a{border:0;padding:0;font-size:10px}.footer-edition{font-size:8px}.footer-legal{font-size:9px}.footer-legal .footer-preview{font-size:7px}}
</style>
